                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EBEEF2"
                    android:layout_marginBottom="24dp"/>

                <!-- SECCIÓN ESPECIFICACIONES -->
                <com.google.android.material.card.MaterialCardView
