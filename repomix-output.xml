                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- REGISTROS -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegistros"
