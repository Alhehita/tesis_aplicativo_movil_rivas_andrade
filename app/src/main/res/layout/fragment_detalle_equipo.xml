<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/portatil_48"
                        app:tint="#212529" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Detalle de Equipo"
                        android:textColor="#212529"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EBEEF2"
                    android:layout_marginBottom="24dp"/>

                <!-- SECCIÓN ESPECIFICACIONES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="#DEE2E6"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#F8F9FA"
                            android:padding="12dp"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@android:drawable/ic_dialog_info"
                                app:tint="#212529"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Especificaciones Técnicas"
                                android:textColor="#212529"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:background="#E0E0E6">

                            <TextView
                                android:id="@+id/tvDetalleCodigo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LAB1-PC01"
                                android:textColor="#1E6BD6"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="20dp"/>

                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="2"
                                android:rowCount="3">

                                <!-- FILA 1 -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="16dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Tipo de Equipo"
                                        android:textColor="#251605"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:id="@+id/tvDetalleTipo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="PC"
                                        android:textColor="#212529"
                                        android:textStyle="bold"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="16dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Laboratorio Asignado"
                                        android:textColor="#251605"
                                        android:textSize="12sp"/>
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical">
                                        <ImageView
                                            android:layout_width="14dp"
                                            android:layout_height="14dp"
                                            android:src="@drawable/ic_lab"
                                            app:tint="#212529"/>
                                        <TextView
                                            android:id="@+id/tvDetalleLaboratorio"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="4dp"
                                            android:text="Laboratorio 1"
                                            android:textColor="#212529"
                                            android:textStyle="bold"/>
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- FILA 2 -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="16dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Marca"
                                        android:textColor="#251605"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:id="@+id/tvDetalleMarca"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Dell"
                                        android:textColor="#212529"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="16dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Modelo"
                                        android:textColor="#251605"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:id="@+id/tvDetalleModelo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="OptiPlex 7090"
                                        android:textColor="#212529"/>
                                </LinearLayout>

                                <!-- FILA 3 -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Número de Serie"
                                        android:textColor="#251605"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:id="@+id/tvDetalleSerie"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SN-L1-01"
                                        android:textColor="#E91E63"/>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_columnWeight="1"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Estado Operativo"
                                        android:textColor="#251605"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:id="@+id/tvDetalleEstado"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="OPERATIVO"
                                        android:textColor="#212529"
                                        android:textStyle="bold"/>
                                </LinearLayout>

                            </GridLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN REPORTAR NOVEDAD -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportarNovedadEquipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Reportar Novedad de este Equipo"
                    android:textAllCaps="false"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/alerta_48"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</ScrollView>
